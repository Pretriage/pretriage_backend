@startuml 01-vista-general
title Diagrama de clases — Vista general
left to right direction
hide circle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
  HeaderBackgroundColor #E2E8F0
}
class Paciente
class Chat
class AdmisionRecepcion
class SesionRecepcion
